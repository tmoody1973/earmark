# Bee — token from the Keychain item the Bee CLI creates (see README)
BEE_TOKEN=replace-me
BEE_API_BASE=https://api.developer.bee.amazon.dev
# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/earmark?sslmode=require
# Vercel AI Gateway key (not needed when deployed on Vercel: OIDC)
AI_GATEWAY_API_KEY=replace-me
# Shared secret the relay appends as ?key= (64 hex chars: openssl rand -hex 32)
EARMARK_WEBHOOK_SECRET=replace-me-with-64-hex-chars
# Where the relay posts (agent dev server; production URL after M2 deploy)
EARMARK_RELAY_URL=http://localhost:2000/api/bee/events
# Models (defaults shown)
TRIAGE_MODEL=typesafe-ai/jev-1.13.0
BENCHMARK_MODEL=openai/gpt-6-luna-decisions
EXTRACT_MODEL=anthropic/claude-haiku-5.5
WRITE_MODEL=anthropic/claude-sonnet-5.5
EMBED_MODEL=openai/text-embedding-3-small
# Clerk (garden sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
EARMARK_OWNER_CLERK_ID=user_replace-me
# Garden owner's first name: people address them in conversation, so it is never credited as a recommender
# EARMARK_OWNER_FIRST_NAME=Tarik
# EARMARK_OWNER_DISPLAY_NAME=Tarik Moody   # optional: "Collected by …" on published Spaces; falls back to the first name
# Owner account email in the Clerk dev instance; only used by pnpm test:e2e
E2E_OWNER_EMAIL=owner@example.com
PHOTO_DECISION_PROVIDER=gateway
OPENAI_API_KEY=
# Bearer token the "Earmark this" Shortcut sends to /api/capture/* (openssl rand -base64 32; min 32 characters)
EARMARK_CAPTURE_TOKEN=
# Email-in (Resend inbound): the three are required together; the route refuses everything while any is blank
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# The only address whose forwards are accepted
EARMARK_OWNER_EMAIL=
# Weekly episode: Amazon Polly (IAM user with polly:SynthesizeSpeech only) and the private podcast feed token
EARMARK_AWS_ACCESS_KEY_ID=
EARMARK_AWS_SECRET_ACCESS_KEY=
EARMARK_AWS_REGION=us-east-1
POLLY_VOICE=Ruth
# Path secret for /feed/<token> (openssl rand -base64 32 | tr '+/' '-_' | tr -d '='; min 32 characters)
EARMARK_FEED_TOKEN=
# MCP server (/api/mcp) with service-level OAuth. All four required together; the routes return 503 while any is blank.
# Production origin, no trailing slash (e.g. https://earmark-tmoody1973.vercel.app)
EARMARK_PUBLIC_BASE_URL=
# Client id: earmark- plus openssl rand -hex 8. Secrets: openssl rand -base64 32 (min 32 characters each)
EARMARK_MCP_CLIENT_ID=
EARMARK_MCP_CLIENT_SECRET=
EARMARK_MCP_JWT_SECRET=
# Notion internal integration token; pnpm forget uses it to move a page to Trash (skipped and reported when unset)
# NOTION_TOKEN=secret_xxx
# Vercel Blob read-write token; pnpm forget uses it to delete photo thumbnails (skipped and reported when unset)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Apple Music (optional add-on to MusicBrainz): adds Apple links/ids to music matches. Skipped with one log line when unset.
# MusicKit key from developer.apple.com → Keys; the .p8 contents with newlines written as \n
# APPLE_TEAM_ID=ABCDE12345
# APPLE_MUSIC_KEY_ID=ABCDE12345
# APPLE_MUSIC_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----
# APPLE_MUSIC_STOREFRONT=us

# Rec lane providers (M3-T4, decision 013). Optional: until a key is set, tips of that type wait as pending
# (one log line per sweep) and are looked up automatically once it is.
# TMDB "API Read Access Token" (Bearer), film_tv: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=eyJxxx
# Podcast Index key + secret (both needed), podcast; without them podcasts use the keyless iTunes Search API
# PODCAST_INDEX_KEY=xxx
# PODCAST_INDEX_SECRET=xxx
# Google Places API (New) key restricted to Places API (New), place
# GOOGLE_PLACES_API_KEY=xxx
# Places work without any key via OpenStreetMap Nominatim (decision 044); Google wins when the key above is set.
# Optional contact address Nominatim's usage policy lets you send so they can reach you:
# NOMINATIM_EMAIL=you@example.com

# Place-lookup bias when neither the conversation nor the tip has a location (decision 046). Rounded to ~11 km before
# it leaves Earmark. Leave both unset for no bias.
# EARMARK_HOME_LAT=43.04
# EARMARK_HOME_LNG=-87.91

# Bee todo write-back (M3-T7, decision 014): queued tips become "Earmark · " todos in Bee, at most 10 open.
# Kill switch: Earmark writes to Bee only when this is exactly "on"; unset or anything else logs one skip line.
# BEE_TODO_WRITES=on
# Origin for the Shelf link in each todo (default https://earmark-two.vercel.app)
# EARMARK_PUBLIC_BASE_URL=https://earmark-two.vercel.app

# Place nudges (M5-T5, FR-16): Bee todo when you are within this many meters of a saved place (50-2000, default 300).
# Calibration knob: Bee's location accuracy is unknown.
NUDGE_RADIUS_M=300
